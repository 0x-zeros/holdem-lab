# Copy this file to `.env` and fill in your real keys.
# `.env` is ignored by git; do not commit real API keys.

# Recommended first pass for Poker Legends annotation.
HOLDEM_LLM_PROVIDER=gemini
HOLDEM_LLM_MODEL=gemini-3.1-flash-lite
HOLDEM_LLM_DETAIL=original

# Gemini API key for `--provider gemini`.
GEMINI_API_KEY=

# Optional alias supported by Google tooling. Leave blank if using GEMINI_API_KEY.
GOOGLE_API_KEY=

# Optional OpenAI fallback for `--provider openai`.
OPENAI_API_KEY=
